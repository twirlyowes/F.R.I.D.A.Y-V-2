DISCORD_TOKEN=your-bot-token

# Whole Firebase service-account JSON on ONE line
FIREBASE_KEY=

PORT=3000

# Your Discord user ID. Controls the owner-only commands
# (addserver, removeserver, servers, noprefix). Several IDs can be comma-separated.
OWNER_ID=

# Optional: prefix for servers that haven't set their own
DEFAULT_PREFIX=.

# Optional: mirror the bot's console into one Discord channel (owner debugging)
CONSOLE_LOG_CHANNEL_ID=
